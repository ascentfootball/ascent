 if(a==='compare-toggle'){let i=compare.indexOf(x);if(i>=0)compare.splice(i,1);else if(compare.length<3)compare.push(x);else{toast('Puoi confrontare al massimo 3 giocatori');return;}closeModal();render();toast(i<0?'Aggiunto al confronto':'Rimosso dal confronto');return;}if(a==='compare-clear'){compare=[];render();return;}if(a==='view'){view=view==='grid'?'list':'grid';render();return;}if(a==='clear-filters'){filters={};render();return;}
 if(a==='apply'){let o=state.opportunities.find(o=>o.id===x);if(!o)return;if(state.applications.some(a=>a.oppId===x&&a.playerName===state.profile.name)){toast('Hai già inviato questa candidatura');return;}state.applications.push({id:id(),oppId:x,playerName:state.profile.name,status:'Inviata'});save();closeModal();render();toast('Candidatura registrata nell’area dimostrativa');return;}
 if(a==='trial-status'){let i=state.invitations.find(i=>i.id===x);if(i){i.status=target.dataset.value;save();render();toast('Risposta registrata nella demo');}return;}if(a==='chat'){activeChat=x;navigate('messages');return;}if(a==='reset'){openModal('Ripristinare i dati demo?','Questa azione cancella le modifiche salvate su questo dispositivo.',`<div class="form-actions"><button class="btn ghost" data-action="close">Annulla</button><button class="btn danger" data-action="confirm-reset">Ripristina</button></div>`);return;}if(a==='confirm-reset'){state=initial();state.name=authUser?.user_metadata?.display_name||authUser?.email?.split('@')[0]||'Utente ASCENT';state.role=roleFromDb[authUser?.user_metadata?.role]||'Giocatore';compare=[];save();navigate('dashboard');toast('Dati locali ripristinati');}
});
document.addEventListener('input',e=>{if(e.target.dataset.filter){let key=e.target.dataset.filter,pos=e.target.selectionStart;filters[key]=e.target.value;render();let next=document.querySelector(`[data-filter="${key}"]`);if(next){next.focus();if(next.tagName==='INPUT')next.setSelectionRange(pos,pos);}return;}if(e.target.dataset.note){state.notes[e.target.dataset.note]=e.target.value;save();}});
document.addEventListener('change',e=>{if(e.target.dataset.setting){state.settings[e.target.dataset.setting]=e.target.checked;save();toast('Preferenze salvate');}if(e.target.dataset.application){let a=state.applications.find(a=>a.id===e.target.dataset.application);if(a){a.status=e.target.value;save();render();toast('Stato aggiornato');}}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modalRoot.innerHTML)closeModal();if(e.key==='Enter'&&e.target.id==='global-search'){filters={q:e.target.value};page='players';mobileOpen=false;render();}});
document.addEventListener('submit',async e=>{e.preventDefault();let form=e.target,data=new FormData(form),v=Object.fromEntries(data.entries());
 if(form.id==='auth-form'){await handleAuthForm(form,v);return;}
 if(form.id==='message-form'){let text=v.message.trim();if(!text)return;(state.messages[activeChat] ||= []).push({from:'me',text});save();render();toast('Messaggio salvato nella demo');}
 if(form.id==='invite-form'){let p=player(v.playerId);if(!p)return;state.invitations.push({id:id(),playerId:p.id,playerName:p.name,clubName:v.clubName,date:v.date,place:v.place,message:v.message,status:'In attesa'});save();closeModal();render();toast('Invito registrato nell’area dimostrativa');}
 if(form.id==='opp-form'){let c=state.clubs.find(c=>c.name===v.clubId);let [min,max]=v.age.split('-').map(Number);if(min>max){toast('Controlla la fascia di età');return;}state.opportunities.unshift({id:id(),...v,clubId:c.id});save();closeModal();navigate('discover');toast('Annuncio pubblicato nell’area dimostrativa');}
 if(form.id==='profile-form'){if(state.role==='Giocatore'){let file=data.get('photo');delete v.photo;let photo=state.profile.photo;if(file&&file.size){if(file.size>1000000){toast('La foto deve essere inferiore a 1 MB');return;}photo=await new Promise(resolve=>{let reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>resolve('');reader.readAsDataURL(file);});}state.profile={...state.profile,...v,age:Number(v.age),height:Number(v.height),photo};let index=state.players.findIndex(p=>p.id===state.profile.id);if(index>=0)state.players[index]={...state.profile};state.name=state.profile.name;}else{state.clubs[0]={...state.clubs[0],...v};if(state.role==='Società')state.name=v.name;}save();closeModal();render();toast('Profilo aggiornato');}
});
startApp();
