function authModal(mode='signup', message=''){
  const isSignup = mode === 'signup';
  const roleOptions = roles.map(role=>`<option value="${esc(role)}">${esc(role)}</option>`).join('');
  openModal(isSignup?'Crea il tuo account':'Bentornato su ASCENT',
    isSignup?'Registrati per entrare nella piattaforma.':'Accedi al tuo account ASCENT.',
    `${message?`<div class="notice">${esc(message)}</div>`:''}
    <form id="auth-form" data-mode="${isSignup?'signup':'login'}">
      <div class="form-grid">
        ${isSignup?formField('Nome e cognome','name','','text','required maxlength="60"'):''}
        <label class="full">Email<input type="email" name="email" autocomplete="email" placeholder="nome@email.com" required></label>
        <label class="full">Password<input type="password" name="password" autocomplete="${isSignup?'new-password':'current-password'}" minlength="6" placeholder="Almeno 6 caratteri" required></label>
        ${isSignup?`<label class="full">Seleziona il tuo ruolo<select name="role" required>${roleOptions}</select></label>`:''}
      </div>
      <div class="form-actions"><button class="btn primary" type="submit">${isSignup?'Crea account':'Accedi'}</button></div>
    </form>
    <div class="section-space" style="text-align:center">
      ${isSignup?`Hai già un account? <button class="text-btn" type="button" data-action="auth-login">Accedi</button>`:`Non hai ancora un account? <button class="text-btn" type="button" data-action="auth-signup">Registrati</button>`}
    </div>`,false);
}

function loadAccountState(user){
  const accountKey = `${KEY}:${user.id}`;
  activeStorageKey = accountKey;
  try{
    const stored = JSON.parse(localStorage.getItem(accountKey));
    state = stored && stored.players && stored.opportunities ? stored : initial();
  }catch{state=initial();}
}

function applyAuthUser(user){
  if(!user)return;
  if(authUser?.id !== user.id) loadAccountState(user);
  authUser = user;
  const dbRole = user.user_metadata?.role || 'player';
  const appRole = roleFromDb[dbRole] || 'Giocatore';
  state.role = appRole;
  const displayName = user.user_metadata?.display_name || user.user_metadata?.full_name || user.email?.split('@')[0] || 'Utente ASCENT';
  state.name = displayName;
  if(appRole==='Giocatore'){
    state.profile = {...state.profile,name:displayName};
    const existingPlayer = state.players.find(p=>p.id===state.profile.id);
    if(existingPlayer) existingPlayer.name = displayName;
  }
  state.onboarded = true;
  save();
}

async function signOutUser(){
  const {error} = await supabaseClient.auth.signOut();
  if(error){toast('Errore durante la disconnessione: '+error.message);return;}
  authSession=null;authUser=null;activeStorageKey=KEY;
  authModal('login','Disconnessione completata.');
}

async function handleAuthForm(form, values){
  const email=(values.email||'').trim().toLowerCase(), password=values.password||'';
  if(!email||!password){toast('Inserisci email e password.');return;}
  const submitButton=form.querySelector('button[type="submit"]');
  if(submitButton){submitButton.disabled=true;submitButton.textContent='Attendi…';}
  try{
    if(form.dataset.mode==='signup'){
      const name=(values.name||'').trim(), role=values.role||'Giocatore';
      if(!name){toast('Inserisci il tuo nome.');return;}
      if(!roleToDb[role]){toast('Seleziona un ruolo valido.');return;}
      const {data,error}=await supabaseClient.auth.signUp({email,password,options:{data:{role:roleToDb[role],display_name:name}}});
      if(error){toast(error.message);return;}
      if(data.session&&data.user){
        authSession=data.session;applyAuthUser(data.user);closeModal();render();toast('Account creato correttamente!');
      }else{
        authModal('login','Registrazione completata. Controlla la tua email e conferma l’account prima di accedere.');
      }
      return;
    }
    const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
    if(error){toast('Accesso non riuscito: '+error.message);return;}
    authSession=data.session;applyAuthUser(data.user);closeModal();render();toast('Accesso effettuato!');
  }catch(err){
    toast('Si è verificato un errore. Riprova tra poco.');
    console.error('Errore autenticazione:',err);
  }finally{
    if(submitButton&&submitButton.isConnected){submitButton.disabled=false;submitButton.textContent=form.dataset.mode==='signup'?'Crea account':'Accedi';}
  }
}

async function startApp(){
  if(!authListenerRegistered){
    authListenerRegistered=true;
    supabaseClient.auth.onAuthStateChange((event,session)=>{
      authSession=session;
      if(session?.user){
        applyAuthUser(session.user);
        if(!modalRoot.innerHTML) render();
        else if(modalRoot.querySelector('#auth-form')){closeModal();render();}
      }else if(event==='SIGNED_OUT'){
        activeStorageKey=KEY;
        authModal('login','Hai effettuato la disconnessione.');
      }
    });
  }
  const {data,error}=await supabaseClient.auth.getSession();
  if(error){
    console.error('Errore recupero sessione:',error);
    authModal('login','Non è stato possibile verificare la sessione. Accedi nuovamente.');
    return;
  }
  if(data.session?.user){
    authSession=data.session;applyAuthUser(data.session.user);closeModal();render();
  }else{
    authModal('signup');
  }
}
